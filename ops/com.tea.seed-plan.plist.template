<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tea.seed-plan</string>
    <key>ProgramArguments</key>
    <array>
        <string>__TEA_PYTHON__</string>
        <string>-m</string>
        <string>tea</string>
        <string>seed-plan</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__TEA_HOME__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TEA_HOME</key>
        <string>__TEA_HOME__</string>
        <key>TEA_LAUNCHD</key>
        <string>1</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>__TEA_HOME__/logs/launchd-seed.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__TEA_HOME__/logs/launchd-seed.stderr.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
